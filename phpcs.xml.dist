<?xml version="1.0"?>
<ruleset name="Albert">
	<description>PHPCS ruleset for Albert plugin</description>

	<!-- Check all PHP files in directory tree by default. -->
	<arg name="extensions" value="php"/>
	<file>.</file>

	<!-- Exclude vendor directory. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<!-- Exclude the wp-scripts build output. The *.asset.php manifests are
	     generated by webpack, gitignored, and rewritten on every build. -->
	<exclude-pattern>*/assets/build/*</exclude-pattern>

	<!-- Exclude developer CLI tooling. `bin/` never ships (see .distignore) and
	     never runs in a web request, so the WordPress ruleset's output-escaping
	     and filesystem rules are answering questions it does not face. PHPStan
	     excludes the same directory for the same reason. -->
	<exclude-pattern>*/bin/*</exclude-pattern>

	<!-- Exclude the verbatim WordPress core block parser copied into test stubs. -->
	<exclude-pattern>*/tests/Unit/stubs/class-wp-block-parser*.php</exclude-pattern>

	<!-- Use WordPress coding standards. -->
	<rule ref="WordPress">
		<!-- Allow short array syntax [] instead of array() -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- Allow PascalCase filenames (Plugin.php, Ability.php, etc.) -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

		<!-- Disable WPCS's "require Yoda" rule and enforce the opposite -->
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

		<!-- Allow WP_REST_Request<array<string, mixed>> PHPDoc syntax for PHPStan compatibility -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>

		<!-- Allow namespaced hook names with forward slashes (albert/settings/...) -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	</rule>

	<!-- Enforce short array syntax. -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- Enforce non-Yoda conditions ($variable === 'value', not 'value' === $variable). -->
	<rule ref="Generic.ControlStructures.DisallowYodaConditions"/>

	<!-- Relax rules for test files — method names are self-documenting. -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test stubs legitimately group related function stubs and class doubles. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
