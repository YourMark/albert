# EditorConfig: https://editorconfig.org
#
# WordPress coding standards: tabs, everywhere, for every language Albert
# ships. Named here as well as in the linters so an editor gets it right
# before PHPCS or Prettier has to say anything.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
