# Distribution ignore - files excluded from production plugin zip

# Hidden / OS files
.DS_Store
.phpunit.result.cache

# Version control
.git/
.gitignore

# Development tooling
.claude
.github
.distignore
.editorconfig

# Dependencies
composer.lock
node_modules/

# Dev config
phpcs.xml.dist
phpstan.neon
phpstan-bootstrap.php
phpunit.xml.dist
phpunit-unit.xml.dist
package.json
package-lock.json
webpack.config.js

# JS/SCSS source — only the compiled assets/build/ output ships
assets/src/

# Dev scripts and tests
bin/
scripts/
tests/

# Documentation (dev-only)
CLAUDE.md
DEVELOPER_GUIDE.md
plan.md

# Build-only: bundled (Mozart-scoped into src/Dependencies/). Never ship the
# unscoped copy — it would re-collide with WooCommerce's WP\MCP\ namespace.
vendor/wordpress/

# Non-permitted vendor files
vendor/bin/
vendor/*/bin/
vendor/**/.deployignore
vendor/**/.deepsource.toml
vendor/**/dist/*.asc
vendor/**/dist/*.asc.sig
vendor/**/*.bat

# WordPress.org directory assets (screenshots, banners, icons)
.wordpress-org
